{
  "manifest_version": 3,
  "name": "Blindfold",
  "version": "0.2.0",
  "description": "Voice-first help for blind users on inaccessible websites. Every action needs your explicit approval.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://blindfold-gppx.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sensitive.js",
        "a11yTree.js",
        "capture.js",
        "describe.js",
        "goal.js",
        "targets.js",
        "executor.js",
        "loop.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "trigger-help": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Ask Blindfold for help on this page"
    }
  }
}
