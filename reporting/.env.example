# Copy this file to .env (in this reporting folder) and fill it in. Never upload .env to GitHub.

# Component 6: free key from https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=paste_your_key_here

# Component 7
# dry_run = save emails as files in output/outbox (default, safe for testing)
# smtp    = really send (run `npm install nodemailer` first), only to ALLOWED_RECIPIENTS
DELIVERY_MODE=dry_run
ALLOWED_RECIPIENTS=your-own-email@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-own-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=your-own-email@gmail.com
